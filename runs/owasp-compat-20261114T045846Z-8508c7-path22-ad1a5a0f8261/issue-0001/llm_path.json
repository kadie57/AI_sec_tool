                       .encoder()\n84:                                             .encodeForHTML(new String(b, 0, size)));\n85:         } catch (Exception e) {\n86:             System.out.println(\"Couldn't open FileInputStream on file: '\" + fileName + \"'\");\n87:             response.getWriter()\n88:                     .println(\n89:                             \"Problem getting FileInputStream: \"\n90:                                     + org.owasp\n91:                                             .esapi\n92:                                             .ESAPI\n93:                                             .encoder()\n94:                                             .encodeForHTML(e.getMessage()));\n95:         } finally {\n96:             if (fis != null) {\n97:                 try {\n98:                     fis.close();\n99:                     fis = null;\n100:                 } catch (Exception e) {\n101:                     // we tried...\n102:                 }\n103:             }\n104:         }\n105:     }\n106: }\n[HẾT MÃ NGUỒN]\n[THÔNG TIN JOERN]\n{\"flow_count\": 1, \"scope\": \"single_file\", \"source_policy\": \"parameters_are_candidates_not_proven_external\"}\nBảng đường đi đầy đủ đã lưu riêng, không đính kèm yêu cầu này. Số luồng không chứng minh nguồn bên ngoài, khả năng khai thác hoặc độ an toàn. Đọc mã nguồn phía trên để xác định đường đi và bằng chứng; không tự dựng nội dung bảng.\n",
