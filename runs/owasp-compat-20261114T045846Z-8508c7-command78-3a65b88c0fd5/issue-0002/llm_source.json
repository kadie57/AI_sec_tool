\");\n68:             throw new ServletException(e);\n69:         }\n70:     }\n71: }\n[/MAIN]\n[HELPER helper:org.owasp.benchmark.helpers.SeparateClassRequest; SHA256=8ec6b1867d27ebe55c79180755447ece6f98746dcfbf0127b2e4ea5646399739]\n18: package org.owasp.benchmark.helpers;\n20: import javax.servlet.http.Cookie;\n21: import javax.servlet.http.HttpServletRequest;\n23: public class SeparateClassRequest {\n24:     private HttpServletRequest request;\n26:     public SeparateClassRequest(HttpServletRequest request) {\n27:         this.request = request;\n28:     }\n30:     public String getTheParameter(String p) {\n31:         return request.getParameter(p);\n32:     }\n34:     public String getTheCookie(String c) {\n35:         Cookie[] cookies = request.getCookies();\n37:         String value = \"\";\n39:         if (cookies != null) {\n40:             for (Cookie cookie : cookies) {\n41:                 if (cookie.getName().equals(c)) {\n42:                     value = cookie.getValue();\n43:                     break;\n44:                 }\n45:             }\n46:         }\n48:         return value;\n49:     }\n52:     public String getTheValue(String p) {\n53:         return \"bar\";\n54:     }\n55: }\n[/HELPER]\n[CẤU TRÚC API — CHƯA KẾT LUẬN AN TOÀN]\n{\"supported\": true, \"api_form\": \"CONSTRUCTOR_STRING_ARRAY\", \"builder_variable\": \"pb\", \"argument_variable\": \"args\", \"call_name\": \"<init>\", \"warning_line\": 60, \"start_line\": 63, \"evidence_lines\": [60, 63], \"reason\": \"Một biến ProcessBuilder được cấu hình rồi gọi start trên cùng biến; descriptor Sonar khớp.\", \"limitation\": \"Chỉ nhận dạng cú pháp và API; chưa chứng minh thực thi shell, đường đi khả thi hay bảo vệ.\"}\n[CPG RÚT GỌN — THAM SỐ KHÔNG TỰ CHỨNG MINH NGUỒN NGOÀI]\n{\"scope\": \"single_file\", \"configuration\": {\"id\": 30064771095, \"line\": 60, \"name\": \"<init>\", \"method_full_name\": \"ANY.<init>:<unresolvedSignature>(1)\", \"code\": \"new ProcessBuilder(args)\", \"argument